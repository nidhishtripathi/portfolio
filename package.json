{
  "name": "mern-portfolio-assignment",
  "version": "1.0.0",
  "description": "Full-Stack MERN Personal Portfolio Website Assignment",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server:start": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "start": "node server/server.js"
  },
  "keywords": [
    "mern",
    "react",
    "node",
    "express",
    "mongodb",
    "portfolio",
    "fullstack"
  ],
  "author": "Nidhish Tripathi",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
